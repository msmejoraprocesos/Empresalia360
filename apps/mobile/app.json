{
  "expo": {
    "name": "Expertalia 360",
    "slug": "expertalia-360",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expertalia360",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "mx.expertalia360.app",
      "supportsTablet": false
    },
    "android": {
      "package": "mx.expertalia360.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F3A68",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F3A68",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Expertalia 360 usa tus fotos para que puedas publicar productos, promociones y anuncios.",
          "cameraPermission": "Expertalia 360 usa la cámara para que tomes fotos de tus productos y promociones."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
